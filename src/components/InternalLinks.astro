---
import { services, servicePath, site } from "@/data/site";

interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;
---

<aside class="internal-links" aria-labelledby="explore-services">
  <h2 id="explore-services">Explore {site.niche.name} in {site.business.city}</h2>
  <p>Compare the available service information, then tell us about your property when you are ready to discuss a quote.</p>
  <ul>
    <li><a href="/">Home</a></li>
    {services.filter((service) => service.slug !== currentSlug).map((service) => (
      <li><a href={servicePath(service.slug)}>{service.navigationLabel}</a></li>
    ))}
    <li><a href="/about/">About our approach</a></li>
    <li><a href="/contact/">Request a quote</a></li>
  </ul>
</aside>
